# Comma-separated Chrome match patterns used for extension host_permissions and content_scripts.matches.
# Copy this file to .env and adjust for your Jira hosts. .env is gitignored.
ALLOWED_SITES=https://*.atlassian.net/*,https://*.jira.com/*

# Optional bridge debug logging. Use 1 for /tmp/jira-enhancer-bridge-debug.log,
# or set JIRA_ENHANCER_LOG_FILE to an explicit path.
JIRA_ENHANCER_DEBUG_LOG=0
# JIRA_ENHANCER_LOG_FILE=/tmp/jira-enhancer-bridge-debug.log

# Optional preview DOM debug logging. Use 1 for /tmp/jira-enhancer-preview-debug.log,
# or set JIRA_ENHANCER_PREVIEW_LOG_FILE to an explicit path.
JIRA_ENHANCER_PREVIEW_DEBUG_LOG=0
# JIRA_ENHANCER_PREVIEW_LOG_FILE=/tmp/jira-enhancer-preview-debug.log
