{
  "name": "jira-enhancer",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "pnpm build && xvfb-run -a playwright test",
    "test:e2e:headed": "pnpm build && playwright test --headed",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "turbo run format:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.0",
    "jsdom": "^29.0.1",
    "lint-staged": "^15.2.0",
    "playwright": "^1.49.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.0"
}
